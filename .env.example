# Light CRM configuration. Copy to .env and replace every "change-me".
# scripts/start-* create .env from this file with generated passwords.
# Never commit .env. With ENV=production the backend refuses to start while a
# secret still contains "change-me".
#
# Use URL-safe passwords (letters and digits, e.g. `openssl rand -hex 24`):
# they are embedded in database URLs.

# --- Application ------------------------------------------------------------
# production | development | test
ENV=production
LOG_LEVEL=INFO

# --- Database (docker-compose.yml builds the database URLs from these) ------
# Superuser, used only by the db container to initialise roles on first start.
POSTGRES_PASSWORD=change-me
# crm_migrator owns the schema and runs migrations (DDL) and backups.
CRM_MIGRATOR_PASSWORD=change-me
# crm_app is used by the backend and worker (data access only).
CRM_APP_PASSWORD=change-me
# Extra databases created on first start, e.g. "crm_test" for pytest.
CRM_EXTRA_DATABASES=

# Signs opaque tokens such as sync cursors. A long random value (e.g.
# `openssl rand -hex 32`); the backend refuses to start in production with the placeholder.
APP_SECRET_KEY=change-me
# Encrypts webhook signing secrets at rest. A long random value (e.g.
# `openssl rand -hex 32`), kept with the database backups: without it, stored webhook
# secrets cannot be read and must be rotated. Refused in production with the placeholder.
APP_ENCRYPTION_KEY=change-me

# --- Integrations -------------------------------------------------------------
# Hosts webhook subscriptions may target (API spec 19.6), comma-separated: exact names
# or "*.suffix" (e.g. erp.internal,*.billing.internal). Empty: webhooks are disabled.
# Loopback, link-local and cloud metadata addresses are always refused.
WEBHOOK_ALLOWED_HOSTS=

# --- AI assistant (architecture section 8) ------------------------------------
# The owner approved the LLM data flow on 2026-11-18 (ADR 0028): questions and CRM data
# from tool results are sent to OpenRouter and Cerebras. Set to true together with the key.
AI_ENABLED=false
# OpenRouter key of a funded account: the default model and the free Nemotron option.
OPENROUTER_API_KEY=
# Google AI Studio key: makes the Gemini 3.5 Flash option available (ADR 0031).
# AI_ENABLED=true needs at least one of the two keys. An Admin chooses the model in
# Settings; the free and Gemini options may let the provider keep prompts.
GEMINI_API_KEY=
# Defaults: openrouter/openai/gpt-oss-120b on Cerebras only, 60 s per model call,
# 200,000 tokens per user per day, 20 messages per user per 10 minutes.
# LLM_MODEL=openrouter/openai/gpt-oss-120b
# LLM_PROVIDER=cerebras
# LLM_TIMEOUT_SECONDS=60
# An OpenAI-compatible endpoint instead of OpenRouter's (e.g. a company gateway); the
# end-to-end stack points it at the scripted server app.llm.fake_server.
# LLM_API_BASE=
# AI_DAILY_TOKEN_BUDGET=200000
# RATE_LIMIT_ASSISTANT_PER_10_MINUTES=20
# Development and end-to-end tests only: a scripted model, no network (refused in production).
# LLM_FAKE=false

# --- Users and email ----------------------------------------------------------
# Address users open; used in password links and the CSRF Origin check.
CRM_PUBLIC_URL=https://localhost
# Optional SMTP relay (A6). Without SMTP_HOST, Admins hand out the
# set-password links shown in the UI and "forgot password" sends nothing. With it, users
# also get a security notice after password and two-factor changes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=crm@localhost
# Sign-in attempts per minute and password-link requests per 15 minutes, per IP
# (API spec section 18).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PASSWORD_PER_15_MINUTES=5

# --- Proxy / TLS ------------------------------------------------------------
# Host name users open, and TLS: "internal" (Caddy's local CA) or
# "/certs/crm.crt /certs/crm.key" for the certificate provided by IT.
CRM_SITE_ADDRESS=localhost
CRM_TLS=internal
# Directory with crm.crt and crm.key, mounted read-only into the proxy as /certs.
CRM_CERTS_DIR=./certs
CRM_HTTP_PORT=80
CRM_HTTPS_PORT=443

# --- Backups ----------------------------------------------------------------
CRM_BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=10

# --- Running the backend outside Docker (uv run ...) ------------------------
# DATABASE_URL=postgresql+asyncpg://crm_app:change-me@localhost:5432/crm
# MIGRATION_DATABASE_URL=postgresql+asyncpg://crm_migrator:change-me@localhost:5432/crm
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_SECONDS=5
# HEALTH_CHECK_TIMEOUT_SECONDS=2
# WORKER_POLL_INTERVAL_SECONDS=5
# PUBLIC_URL=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=["http://localhost:5173"]
# LOGIN_MAX_FAILED_ATTEMPTS=5  LOGIN_LOCKOUT_MINUTES=15
# PASSWORD_SET_TOKEN_HOURS=72  PASSWORD_RESET_TOKEN_HOURS=2
# RATE_LIMIT_USER_PER_MINUTE=600
# Tests (pytest) use a separate database:
# TEST_DATABASE_URL=postgresql+asyncpg://crm_migrator:change-me@localhost:5432/crm_test
# TEST_APP_DATABASE_URL=postgresql+asyncpg://crm_app:change-me@localhost:5432/crm_test
