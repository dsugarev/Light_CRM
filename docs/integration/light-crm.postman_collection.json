{
  "info": {
    "name": "Light CRM integration API (v1)",
    "description": "Requests for Conclusion, ERP and Billing. Set baseUrl, apiKey and system in the collection variables. See docs/integration-guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://crm.example.bg"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "system",
      "value": "erp"
    },
    {
      "key": "updatedSince",
      "value": "2026-01-01T00:00:00Z"
    },
    {
      "key": "cursor",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": ""
    },
    {
      "key": "opportunityId",
      "value": ""
    },
    {
      "key": "externalId",
      "value": "C-10023"
    }
  ],
  "item": [
    {
      "name": "Connection",
      "item": [
        {
          "name": "Who am I (connection test)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Returns principal_type integration, your system and scopes."
          }
        },
        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "openapi.json"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Organizations changed since (first page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations?updated_since={{updatedSince}}&page_size=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations"
              ],
              "query": [
                {
                  "key": "updated_since",
                  "value": "{{updatedSince}}"
                },
                {
                  "key": "page_size",
                  "value": "500"
                }
              ]
            },
            "description": "Follow next_cursor until it is null; store the largest updated_at."
          }
        },
        {
          "name": "Organizations changed since (next page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations?updated_since={{updatedSince}}&page_size=500&cursor={{cursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations"
              ],
              "query": [
                {
                  "key": "updated_since",
                  "value": "{{updatedSince}}"
                },
                {
                  "key": "page_size",
                  "value": "500"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Contacts changed since",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/contacts?updated_since={{updatedSince}}&page_size=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "contacts"
              ],
              "query": [
                {
                  "key": "updated_since",
                  "value": "{{updatedSince}}"
                },
                {
                  "key": "page_size",
                  "value": "500"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Opportunities changed since",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/opportunities?updated_since={{updatedSince}}&page_size=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "opportunities"
              ],
              "query": [
                {
                  "key": "updated_since",
                  "value": "{{updatedSince}}"
                },
                {
                  "key": "page_size",
                  "value": "500"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Records",
      "item": [
        {
          "name": "Organization",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organizationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organizationId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Organization contacts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organizationId}}/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organizationId}}",
                "contacts"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Opportunity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/opportunities/{{opportunityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "opportunities",
                "{{opportunityId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Won opportunities not yet in my system",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/opportunities?stage_type=won&external_system={{system}}&has_external_reference=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "opportunities"
              ],
              "query": [
                {
                  "key": "stage_type",
                  "value": "won"
                },
                {
                  "key": "external_system",
                  "value": "{{system}}"
                },
                {
                  "key": "has_external_reference",
                  "value": "false"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Reference list (industries)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reference/industries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reference",
                "industries"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Find a person by email (owner_id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/lookup?email=ivan.petrov@example.bg",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "lookup"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "ivan.petrov@example.bg"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "External references",
      "item": [
        {
          "name": "Resolve my ID to a CRM record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/external-references?system={{system}}&external_id={{externalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "external-references"
              ],
              "query": [
                {
                  "key": "system",
                  "value": "{{system}}"
                },
                {
                  "key": "external_id",
                  "value": "{{externalId}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "IDs of an organization",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organizationId}}/external-references",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organizationId}}",
                "external-references"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Write my ID on an organization",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organizationId}}/external-references/{{system}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organizationId}}",
                "external-references",
                "{{system}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": \"{{externalId}}\",\n  \"url\": \"https://erp.example.bg/customers/{{externalId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remove my ID from an organization",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organizationId}}/external-references/{{system}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                "{{organizationId}}",
                "external-references",
                "{{system}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Writes (only with write scopes)",
      "item": [
        {
          "name": "Create organization (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations"
              ]
            },
            "description": "Requires organizations:write. Reuse the same Idempotency-Key when retrying.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Акме ЕООД\",\n  \"city\": \"София\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
